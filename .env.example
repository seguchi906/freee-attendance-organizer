DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_TENANT_ID=
NEXT_PUBLIC_ALLOWED_AUTH_EMAILS=user1@example.com,user2@example.com
NEXT_PUBLIC_PORTAL_ORIGINS=https://n-app-portal.netlify.app

# Server-only mapping: Entra user Object IDs verified against the existing allowed email list.
# Empty/missing configuration denies all API access. Do not use the API app ID here.
ATTENDANCE_ALLOWED_USERS=[{"oid":"USER-OBJECT-ID","email":"user1@example.com"}]

# Server-only: Single Entra user Object ID permitted for company-report client access.
# If empty, invalid, or missing, access from the company-report client is denied.
COMPANY_REPORT_ALLOWED_OID=00000000-0000-4000-8000-000000000011
